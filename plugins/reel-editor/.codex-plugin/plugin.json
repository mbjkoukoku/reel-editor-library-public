      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA01\u3092\u4f7f\u3044\u307e\u3059\u3002\u307e\u305a\u53f0\u672c\u3060\u3051\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002LP\u3092\u9001\u308a\u307e\u3059\u3002\u53c2\u8003\u52d5\u753b\u306e\u6587\u7ae0\u30fb\u8a00\u3044\u56de\u3057\u30fb\u9806\u756a\u3092\u4fdd\u3061\u3001\u9662\u540d\u30fb\u5730\u57df\u30fb\u99c5\u540d\u306a\u3069\u3068\u5e97\u8217\u3054\u3068\u306b\u7570\u306a\u308b\u4e8b\u5b9f\u3060\u3051\u3092\u78ba\u8a8d\u3057\u3066\u5dee\u3057\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u53f0\u672c\u78ba\u8a8d\u5f8c\u306b\u7d20\u6750\u3068AI\u97f3\u58f0\u3092\u540c\u3058\u30bf\u30b9\u30af\u3078\u9001\u308a\u307e\u3059\u3002\u4eca\u306f\u52d5\u753b\u7de8\u96c6\u30fb\u97f3\u58f0\u751f\u6210\u3092\u59cb\u3081\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA02\u3092\u4f7f\u3044\u307e\u3059\u3002\u307e\u305a\u53f0\u672c\u3060\u3051\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002LP\u3092\u9001\u308a\u307e\u3059\u3002\u53c2\u8003\u52d5\u753b\u306e\u6587\u7ae0\u30fb\u8a00\u3044\u56de\u3057\u30fb\u9806\u756a\u3092\u4fdd\u3061\u3001\u9662\u540d\u30fb\u5730\u57df\u30fb\u99c5\u540d\u306a\u3069\u3068\u5e97\u8217\u3054\u3068\u306b\u7570\u306a\u308b\u4e8b\u5b9f\u3060\u3051\u3092\u78ba\u8a8d\u3057\u3066\u5dee\u3057\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u53f0\u672c\u78ba\u8a8d\u5f8c\u306b\u7d20\u6750\u3068AI\u97f3\u58f0\u3092\u540c\u3058\u30bf\u30b9\u30af\u3078\u9001\u308a\u307e\u3059\u3002\u4eca\u306f\u52d5\u753b\u7de8\u96c6\u30fb\u97f3\u58f0\u751f\u6210\u3092\u59cb\u3081\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA03\u3092\u4f7f\u3044\u307e\u3059\u3002\u307e\u305a\u30c6\u30ed\u30c3\u30d7\u53f0\u672c\u3060\u3051\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002LP\u3092\u9001\u308a\u307e\u3059\u3002\u898b\u672c\u306e\u30c6\u30ed\u30c3\u30d7\u306e\u5927\u67a0\u30fb\u9806\u756a\u3092\u4fdd\u3061\u3001\u5e97\u8217\u3054\u3068\u306b\u7570\u306a\u308b\u4e8b\u5b9f\u3060\u3051\u3092\u78ba\u8a8d\u3057\u3066\u5dee\u3057\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u4f1a\u8a71\u306e\u6587\u5b57\u8d77\u3053\u3057\u306f\u3057\u307e\u305b\u3093\u3002\u53f0\u672c\u78ba\u8a8d\u5f8c\u306b\u7d20\u6750\u52d5\u753b\u3060\u3051\u3092\u540c\u3058\u30bf\u30b9\u30af\u3078\u9001\u308a\u307e\u3059\u3002\u5168\u97f3\u58f0\u306a\u3057\u3067\u3001\u4eca\u306f\u52d5\u753b\u7de8\u96c6\u3092\u59cb\u3081\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA04\u3092\u4f7f\u3044\u3001\u4eca\u56de\u306e\u5143\u97f3\u58f0\u4ed8\u304d\u7d20\u6750\u52d5\u753b\u3092\u7de8\u96c6\u3057\u3066\u304f\u3060\u3055\u3044\u3002LP\u30fb\u65b0\u898f\u53f0\u672c\u30fbAI\u97f3\u58f0\u306f\u4e0d\u8981\u3067\u3059\u3002\u4e0d\u8981\u306a\u30d5\u30a3\u30e9\u30fc\u3068\u9577\u3044\u9593\u3092\u81ea\u7136\u306b\u6574\u7406\u3057\u3001\u6b8b\u3063\u305f\u767a\u8a00\u3092\u305d\u306e\u307e\u307e\u30c6\u30ed\u30c3\u30d7\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u767d\u3044\u89d2\u4e38\u80cc\u666f\u3068\u9ed2\u592a\u5b57\u3001\u8d64\u3044\u5f37\u8abf\u3001\u540c\u69d8\u306e\u77ed\u3044\u52b9\u679c\u97f3\u3092\u898b\u672c\u306b\u5408\u308f\u305b\u3066\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA05\u3092\u4f7f\u3044\u307e\u3059\u3002LP\u3092\u9001\u308b\u306e\u3067\u3001\u307e\u305a\u77ed\u3044\u753b\u9762\u30c6\u30ed\u30c3\u30d7\u30fb\u9662\u540d\u306e\u8868\u793a\u30fb\u914d\u8272\u6848\u3060\u3051\u3092\u4f5c\u308a\u3001\u78ba\u8a8d\u3092\u5f85\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u78ba\u8a8d\u5f8c\u306b\u65bd\u8853\u524d\u5f8c\u306e\u5bfe\u5fdc\u304c\u5206\u304b\u308b\u7d20\u6750\u52d5\u753b\u3092\u9001\u308a\u307e\u3059\u3002\u524d\u5f8c\u3092\u660e\u793a\u3057\u3001\u6bd4\u8f03\u3057\u3084\u3059\u3044\u753b\u89d2\u3067\u7de8\u96c6\u3057\u3066\u60a3\u8005\u306e\u9854\u3078\u30e2\u30b6\u30a4\u30af\u3092\u304b\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u52d5\u4f5c\u6642\u9593\u3092\u7121\u97f3\u3060\u3051\u3067\u524a\u3089\u305a\u3001\u898b\u672c\u306e\u9662\u540d\u3084\u7d50\u679c\u306f\u6d41\u7528\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002AI\u97f3\u58f0\u30fbBGM\u306f\u751f\u6210\u305b\u305a\u3001\u4eca\u306f\u6620\u50cf\u7de8\u96c6\u3092\u59cb\u3081\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA06\u300c\u8a71\u306e\u8981\u70b9\u30fb\u30b3\u30fc\u30e9\u30eb\u5e2f\u30c7\u30b6\u30a4\u30f3\u300d\u3067\u3001\u5143\u97f3\u58f0\u4ed8\u304d\u7d20\u6750\u52d5\u753b\u3092\u7de8\u96c6\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8a71\u306e\u5185\u5bb9\u3092\u5206\u6790\u3057\u3001\u6839\u62e0\u304c\u3042\u308b\u77ed\u3044\u30c6\u30fc\u30de\u30fb\u8981\u70b9\u3092\u898b\u672c\u306e\u30c7\u30b6\u30a4\u30f3\u3078\u914d\u7f6e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u9010\u8a9e\u5b57\u5e55\u306b\u306f\u305b\u305a\u3001\u898b\u672c\u306e\u6587\u7ae0\u30fb\u6210\u679c\u30fb\u9662\u540d\u3092\u6d41\u7528\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u5143\u58f0\u3092\u6b8b\u3057\u3001LP\u306f\u4efb\u610f\u306e\u5e97\u8217\u60c5\u5831\u78ba\u8a8d\u7528\u3068\u3057\u3066\u6271\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u65b0\u898fAI\u97f3\u58f0\u30fbBGM\u30fb\u52b9\u679c\u97f3\u306f\u8ffd\u52a0\u305b\u305a\u3001\u60a3\u8005\u306e\u9854\u3078\u5171\u901a\u624b\u9806\u3067\u30e2\u30b6\u30a4\u30af\u3092\u4ed8\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u5b57\u4f53\u306fNoto Sans JP 900\u76f8\u5f53\u3092\u65e2\u5b9a\u5019\u88dc\u306b\u3057\u3001\u5143\u898b\u672c\u3068\u540c\u4e00\u3068\u306f\u65ad\u5b9a\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u8ca0\u306e\u5b57\u9593\u3067\u8a70\u3081\u305a\u30012\u884c\u306f\u5341\u5206\u306a\u884c\u9593\u3092\u53d6\u308a\u3001\u5de6\u53f3\u306e\u4f59\u767d\u304c\u4f59\u308b\u77ed\u6587\u306f\u5b89\u5168\u4f59\u767d\u3092\u4fdd\u3061\u306a\u304c\u3089\u5927\u304d\u304f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u672c\u6587\u3068\u7d42\u76e4\u3092\u305d\u308c\u305e\u308c\u5927\u304d\u306a1\u679a\u306e\u5408\u6210\u753b\u9762\u3067\u78ba\u8a8d\u3057\u3001\u5207\u66ff\u5883\u754c\u3068\u6700\u7d42\u30d5\u30ec\u30fc\u30e0\u3082\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA07\u300c\u60a3\u8005\u76ee\u7dda\u30fb1\u65e5Vlog\u300d\u3067\u3001\u307e\u305aLP\u304b\u3089\u53f0\u672c\u3068\u5834\u9762\u8868\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u672a\u5c0e\u5165\u306a\u3089\u516c\u958b\u914d\u5e03\u5143 https://github.com/mbjkoukoku/reel-editor-library-public \u306eREADME\u3068first-use.md\u306b\u6cbf\u3063\u3066\u521d\u56de\u8a2d\u5b9a\u3082\u9032\u3081\u3066\u304f\u3060\u3055\u3044\u30020.10.5\u306e\u627f\u8a8d\u6e08\u307f\u672c\u658778px\u30fb\u884c\u9ad8104px\u3001\u63a7\u3048\u3081\u306aBGM\u30fb\u8d77\u5e8a\u7b49\u306e\u52b9\u679c\u97f3\u3001\u5e30\u5b85\u3057\u3066\u5bb6\u4e8b\u2192\u8170\u304c\u8efd\u304f\u5bb6\u4e8b\u3082\u697d\u2192\u65c5\u884c\u3078\u306e\u610f\u6b32\u2192\u6765\u3066\u3088\u304b\u3063\u305f\u3001\u306e\u6d41\u308c\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u53f0\u672c\u78ba\u8a8d\u5f8c\u306b\u7d20\u6750\u3092\u9001\u308a\u3001\u5fc5\u8981\u306a\u751f\u6210\u3060\u3051\u5185\u5bb9\u30fb\u8cbb\u7528\u3092\u5148\u306b\u78ba\u8a8d\u3057\u3066\u304b\u3089\u7de8\u96c6\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
      "\u52d5\u753b\u7de8\u96c6\u30e9\u30a4\u30d6\u30e9\u30ea\u306eA08\u300c\u9662\u7d39\u4ecb\u30fb\u660e\u671d\u5e2f\uff0b\u672c\u4eba\u306e\u6848\u5185\u300d\u3092\u4f7f\u3044\u307e\u3059\u3002LP\u3092\u9001\u308b\u306e\u3067\u3001\u307e\u305a\u524d\u534a\u306e\u753b\u9762\u30c6\u30ed\u30c3\u30d7\u53f0\u672c\u3068\u5f8c\u534a\u306e\u672c\u4eba\u304c\u8a71\u3059\u6848\u5185\u6587\u3060\u3051\u3092\u4f5c\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u5143\u97f3\u58f0\u4ed8\u304d\u7d20\u6750\u304c\u3059\u3067\u306b\u3042\u308c\u3070\u3001\u305d\u306e\u5b9f\u767a\u8a71\u3092\u6839\u62e0\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u898b\u672c\u306e\u69cb\u6210\u3092\u4fdd\u3061\u3001\u5730\u57df\u30fb\u65bd\u8853\u5185\u5bb9\u30fb\u4fa1\u683c\u30fb\u5272\u5f15\u30fb\u4e88\u7d04\u5148\u306f\u4eca\u56de\u78ba\u8a8d\u3067\u304d\u308b\u4e8b\u5b9f\u3060\u3051\u306b\u5dee\u3057\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u78ba\u8a8d\u5f8c\u306b\u65bd\u8853\u30fb\u691c\u67fb\u3068\u672c\u4eba\u306e\u547c\u3073\u304b\u3051\u306e\u5143\u97f3\u58f0\u4ed8\u304d\u7d20\u6750\u3092\u540c\u3058\u30bf\u30b9\u30af\u3078\u9001\u308a\u307e\u3059\u3002\u65b0\u898fAI\u97f3\u58f0\u306f\u4e0d\u8981\u3067\u3059\u3002\u524d\u534a\u306e\u767d\u3044\u660e\u671d\u30fb\u534a\u900f\u660e\u30b0\u30ec\u30fc\u89d2\u4e38\u5e2f\u3001\u5f8c\u534a\u306e\u767d\u3044\u5c0f\u5b57\u5e55\u30fb\u8d64\u5f37\u8abf\u3092A08\u4ed5\u69d8\u306b\u5408\u308f\u305b\u3001\u672c\u4eba\u58f0\u3092\u6b8b\u3057\u3066\u7de8\u96c6\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4eca\u306f\u53f0\u672c\u4f5c\u6210\u3060\u3051\u3067\u3059\u3002 \u30c6\u30ed\u30c3\u30d7\u306f1\u884c8\u6587\u5b57\u4ee5\u5185\u30fb\u6700\u59272\u884c\u3067\u610f\u5473\u306e\u533a\u5207\u308a\u3067\u6539\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u53ce\u307e\u3089\u306a\u3044\u6587\u7ae0\u306f\u6b21\u306e\u30c6\u30ed\u30c3\u30d7\u3078\u5206\u3051\u3001\u8aad\u3081\u308b\u6642\u9593\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u30023\u884c\u3084\u30d5\u30a9\u30f3\u30c8\u7e2e\u5c0f\u30fb\u884c\u9593\u8a70\u3081\u3067\u62bc\u3057\u8fbc\u307e\u305a\u3001\u884c\u9593\u306e\u4f59\u767d\u3092\u53d6\u308a\u3001\u6587\u5b57\u3068\u5f71\u304c\u91cd\u306a\u3089\u306a\u3044\u3053\u3068\u3092\u5b9f\u5408\u6210\u3067\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7de8\u96c6\u6642\u306f\u6574\u4f53\u9662\u306b\u5408\u3046\u7121\u6599BGM\u3092\u516c\u5f0f\u306e\u5546\u7528SNS\u52d5\u753b\u5229\u7528\u6761\u4ef6\u3092\u78ba\u8a8d\u3057\u3066\u9078\u3073\u3001\u672c\u4eba\u58f0\u3092\u90aa\u9b54\u3057\u306a\u3044\u97f3\u91cf\u3068\u81ea\u7136\u306a\u30d5\u30a7\u30fc\u30c9\u3067\u5165\u308c\u3066\u304f\u3060\u3055\u3044\u3002\u4eca\u56de\u306eBGM\u306a\u3057\u6307\u5b9a\u306f\u512a\u5148\u3057\u307e\u3059\u3002 A08\u306fa08.json\u306eproductionDefaults\u3092\u57fa\u6e96\u306b\u30011080\u00d72336\u3067\u524d\u534a125px\u30fb\u7d42\u76e4107px\u3001\u884c\u9ad81.20\u500d\u30fb\u5b57\u95930\u3092\u4f7f\u3044\u3001\u540c\u3058\u7e26\u6a2a\u6bd4\u306e\u5225\u89e3\u50cf\u5ea6\u306f\u540c\u500d\u7387\u3067\u63db\u7b97\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c6\u30ed\u30c3\u30d7\u6570\u3084\u5b8c\u6210\u79d2\u6570\u306f\u56fa\u5b9a\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
      "\u767b\u9332\u3055\u308c\u3066\u3044\u308b\u7de8\u96c6\u30d1\u30bf\u30fc\u30f3\u3092\u898b\u305b\u3066\u304f\u3060\u3055\u3044\u3002",
      "\u3053\u306e\u898b\u672c\u3092\u65b0\u3057\u3044\u7de8\u96c6\u30d1\u30bf\u30fc\u30f3\u3068\u3057\u3066\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
    ]
  }
}
